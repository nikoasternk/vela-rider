<template>
  <div class="screen">
    <div class="hud">
      <text class="hud-score">{{ score }}</text>
      <text class="hud-info" onclick="onSwitchTheme">{{ infoText }}</text>
    </div>

    <stack class="viewport">
      <chart
        class="track-chart"
        type="line"
        options="{{ lineOpts }}"
        datasets="{{ lineData }}"
      ></chart>

      <div class="sprite-layer">
        <div class="gem-node" style="left: {{ gemX }}px; top: {{ gemY }}px;"></div>
        <div class="bike-wheel" style="left: {{ rx }}px; top: {{ ry }}px;"></div>
        <div class="bike-wheel" style="left: {{ fx }}px; top: {{ fy }}px;"></div>
        <div class="bike-core" style="left: {{ cx }}px; top: {{ cy }}px;"></div>
        <div class="bike-visor" style="left: {{ vxVisor }}px; top: {{ vyVisor }}px;"></div>
      </div>
    </stack>

    <text
      class="deck-btn"
      ontouchstart="onHoldStart"
      ontouchend="onHoldEnd"
      ontouchcancel="onHoldEnd"
      onclick="onDeckTap"
    >{{ btnText }}</text>
  </div>
</template>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import { createGameEngine } from '../../common/engine.js'

let engineInstance = null
let loopTimer = null
let lastTickMs = 0

export default {
  private: {
    score: 0,
    bestScore: 0,
    gems: 0,
    infoText: 'BEST 0  ◆ 0',
    btnText: 'HOLD TO RIDE',
    isHolding: false,
    rx: 32,
    ry: 164,
    cx: 42,
    cy: 164,
    fx: 52,
    fy: 164,
    vxVisor: 42,
    vyVisor: 155,
    gemX: -30,
    gemY: -30,
    lineOpts: {
      xAxis: {
        min: 0,
        max: 15,
        axisTick: 15,
        display: false
      },
      yAxis: {
        min: 0,
        max: 240,
        axisTick: 8,
        display: false
      },
      series: {
        lineStyle: {
          width: '4px',
          smooth: true
        }
      }
    },
    lineData: [
      {
        strokeColor: '#00F0FF',
        fillColor: '#052636',
        gradient: true,
        data: [70, 70, 70, 70, 70, 70, 70, 70, 70, 70, 70, 70, 70, 70, 70, 70]
      }
    ]
  },

  onInit() {
    engineInstance = createGameEngine(Date.now() & 0xffffffff)
    this.syncView(engineInstance.getRenderSnapshot(), true)
    this.loadSavedData()
  },

  onShow() {
    try {
      if (brightness && typeof brightness.setKeepScreenOn === 'function') {
        brightness.setKeepScreenOn({ keepScreenOn: true })
      }
    } catch (e) {}
    this.startLoop()
  },

  onHide() {
    this.isHolding = false
    this.stopLoop()
  },

  onDestroy() {
    this.stopLoop()
    try {
      if (brightness && typeof brightness.setKeepScreenOn === 'function') {
        brightness.setKeepScreenOn({ keepScreenOn: false })
      }
    } catch (e) {}
  },

  loadSavedData() {
    try {
      storage.get({
        key: 'rider_band10_save',
        success: (data) => {
          if (data) {
            try {
              const parsed = JSON.parse(data)
              if (typeof parsed.best === 'number') {
                this.bestScore = parsed.best
                engineInstance.state.bestScore = parsed.best
              }
              if (typeof parsed.gems === 'number') {
                this.gems = parsed.gems
                engineInstance.state.gems = parsed.gems
              }
              this.updateHudInfo(engineInstance.getRenderSnapshot())
            } catch (e) {}
          }
        }
      })
    } catch (e) {}
  },

  saveProgress() {
    try {
      storage.set({
        key: 'rider_band10_save',
        value: JSON.stringify({
          best: this.bestScore,
          gems: this.gems
        })
      })
    } catch (e) {}
  },

  pulseHaptic(mode) {
    try {
      if (vibrator && typeof vibrator.vibrate === 'function') {
        vibrator.vibrate({ mode: mode || 'short' })
      }
    } catch (e) {}
  },

  startLoop() {
    this.stopLoop()
    lastTickMs = Date.now()
    const tick = () => {
      if (!engineInstance) return
      const now = Date.now()
      const dt = (now - lastTickMs) * 0.001
      lastTickMs = now

      if (engineInstance.state.status === 'playing') {
        const res = engineInstance.step(dt, this.isHolding)
        this.syncView(engineInstance.getRenderSnapshot(), false)

        if (res.event === 'flip' || res.event === 'gem' || res.event === 'land') {
          this.pulseHaptic('short')
        } else if (res.event === 'crash') {
          this.isHolding = false
          this.pulseHaptic('long')
          this.saveProgress()
        }
      }

      loopTimer = setTimeout(tick, 36)
    }
    loopTimer = setTimeout(tick, 36)
  },

  stopLoop() {
    if (loopTimer !== null) {
      clearTimeout(loopTimer)
      loopTimer = null
    }
  },

  updateHudInfo(snap) {
    const nextInfo = snap.bannerText
      ? snap.bannerText
      : 'BEST ' + snap.bestScore + '  ◆ ' + snap.gems
    if (this.infoText !== nextInfo) {
      this.infoText = nextInfo
    }
  },

  syncView(snap, forceChart) {
    if (forceChart || snap.status === 'playing') {
      this.lineData = [
        {
          strokeColor: snap.theme.track,
          fillColor: snap.theme.fill,
          gradient: true,
          data: snap.chartData.slice(0)
        }
      ]
    }

    const b = snap.bike
    if (this.rx !== b.rx) this.rx = b.rx
    if (this.ry !== b.ry) this.ry = b.ry
    if (this.cx !== b.cx) this.cx = b.cx
    if (this.cy !== b.cy) this.cy = b.cy
    if (this.fx !== b.fx) this.fx = b.fx
    if (this.fy !== b.fy) this.fy = b.fy
    if (this.vxVisor !== b.vxVisor) this.vxVisor = b.vxVisor
    if (this.vyVisor !== b.vyVisor) this.vyVisor = b.vyVisor

    if (this.gemX !== snap.gemX) this.gemX = snap.gemX
    if (this.gemY !== snap.gemY) this.gemY = snap.gemY

    if (this.score !== snap.score) this.score = snap.score
    if (this.bestScore !== snap.bestScore) this.bestScore = snap.bestScore
    if (this.gems !== snap.gems) this.gems = snap.gems

    this.updateHudInfo(snap)

    let nextBtn = 'HOLD: GAS / FLIP'
    if (snap.status === 'menu') {
      nextBtn = 'START RIDER'
    } else if (snap.status === 'gameover') {
      nextBtn = 'CRASH! TAP RETRY'
    } else if (this.isHolding) {
      nextBtn = b.onGround ? 'BOOSTING >>' : 'BACKFLIP >>'
    }
    if (this.btnText !== nextBtn) {
      this.btnText = nextBtn
    }
  },

  onHoldStart() {
    if (!engineInstance) return
    if (engineInstance.state.status !== 'playing') {
      engineInstance.startGame()
      lastTickMs = Date.now()
      this.syncView(engineInstance.getRenderSnapshot(), true)
      this.pulseHaptic('short')
    }
    this.isHolding = true
  },

  onHoldEnd() {
    this.isHolding = false
  },

  onDeckTap() {
    if (!engineInstance) return
    if (engineInstance.state.status !== 'playing') {
      engineInstance.startGame()
      lastTickMs = Date.now()
      this.syncView(engineInstance.getRenderSnapshot(), true)
      this.pulseHaptic('short')
    }
  },

  onSwitchTheme() {
    if (!engineInstance) return
    engineInstance.cycleTheme()
    this.syncView(engineInstance.getRenderSnapshot(), true)
    this.pulseHaptic('short')
  }
}
</script>

<style>
.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  background-color: #000000;
}

.hud {
  width: 184px;
  height: 92px;
  margin-top: 18px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.hud-score {
  font-size: 42px;
  color: #FFFFFF;
}

.hud-info {
  font-size: 16px;
  color: #00F0FF;
  margin-top: 4px;
}

.viewport {
  width: 210px;
  height: 240px;
  background-color: #000000;
}

.track-chart {
  width: 210px;
  height: 240px;
}

.sprite-layer {
  width: 210px;
  height: 240px;
}

.bike-wheel {
  position: absolute;
  width: 12px;
  height: 12px;
  border-radius: 6px;
  border-width: 3px;
  border-color: #00F0FF;
  background-color: #000000;
}

.bike-core {
  position: absolute;
  width: 12px;
  height: 10px;
  border-radius: 5px;
  background-color: #FF0055;
}

.bike-visor {
  position: absolute;
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background-color: #FFD700;
}

.gem-node {
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 5px;
  background-color: #FFD700;
}

.deck-btn {
  width: 184px;
  height: 112px;
  margin-top: 26px;
  border-radius: 44px;
  border-width: 3px;
  border-color: #00F0FF;
  background-color: #06151F;
  font-size: 20px;
  color: #00F0FF;
  text-align: center;
}
</style>
