.screen {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  background-color: #000000;
}

.hud {
  width: 184px;
  height: 78px;
  margin-top: 14px;
  flex-direction: column;
  justify-content: space-between;
}

