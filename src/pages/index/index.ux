<template>
  <stack class="screen">
    <div
      class="game-layout"
      if="{{ !showGarage && !showSettings }}"
      ontouchstart="onScreenHoldStart"
      ontouchend="onScreenHoldEnd"
      ontouchcancel="onScreenHoldEnd"
    >
      <div class="hud-top">
        <div class="hud-row">
          <div class="hud-left-spacer"></div>
          <text class="hud-score">{{ score }}</text>
          <text class="hud-gems">◆ {{ gems }}</text>
        </div>
        <text class="hud-info" style="color: {{ bannerColor }};">{{ infoText }}</text>
      </div>

      <stack class="viewport">
        <chart
          class="track-chart"
          type="line"
          options="{{ lineOpts }}"
          datasets="{{ lineData }}"
        ></chart>

        <div class="abyss-mask"></div>

        <div class="pit-node" style="left: {{ pit0X }}px; width: {{ pit0W }}px;"></div>
        <div class="pit-node" style="left: {{ pit1X }}px; width: {{ pit1W }}px;"></div>

        <image class="boost-sprite" src="/common/boost.png" style="left: {{ boost0X }}px; top: {{ boost0Y }}px;"></image>
        <image class="boost-sprite" src="/common/boost.png" style="left: {{ boost1X }}px; top: {{ boost1Y }}px;"></image>

        <image class="saw-sprite" src="/common/saw.png" style="{{ saw0Style }}"></image>
        <image class="saw-sprite" src="/common/saw.png" style="{{ saw1Style }}"></image>

        <image class="gem-sprite" src="/common/gem.png" style="left: {{ gem0X }}px; top: {{ gem0Y }}px;"></image>
        <image class="gem-sprite" src="/common/gem.png" style="left: {{ gem1X }}px; top: {{ gem1Y }}px;"></image>
        <image class="gem-sprite" src="/common/gem.png" style="left: {{ gem2X }}px; top: {{ gem2Y }}px;"></image>

        <image
          class="bike-sprite"
          if="{{ !isCrashing }}"
          src="{{ bikeSrc }}"
          style="{{ bikeStyle }}"
        ></image>

        <div class="shard-node" style="left: {{ s0X }}px; top: {{ s0Y }}px;"></div>
        <div class="shard-node" style="left: {{ s1X }}px; top: {{ s1Y }}px;"></div>
        <div class="shard-node" style="left: {{ s2X }}px; top: {{ s2Y }}px;"></div>
        <div class="shard-node" style="left: {{ s3X }}px; top: {{ s3Y }}px;"></div>

        <text class="popup-text" if="{{ popupActive }}" style="left: {{ popX }}px; top: {{ popY }}px;">{{ popupText }}</text>
        <div class="crash-flash" if="{{ showFlash }}"></div>
      </stack>

      <div class="bottom-bar">
        <text class="mission-hud" if="{{ isPlayingState }}">{{ missionText }}</text>
        <text class="fps-counter" if="{{ showFps && isPlayingState }}">{{ fpsText }}</text>
      </div>
    </div>

    <div class="pause-hit" if="{{ isPlayingState && !showGarage && !showSettings }}" onclick="onPauseTap">
      <text class="pause-icon">||</text>
    </div>

    <div class="menu-bottom-overlay" if="{{ isMenuState && !showGarage && !showSettings }}">
      <text class="menu-hint">УДЕРЖИВАЙ ДЛЯ СТАРТА</text>
      <div class="menu-btn-row">
        <text class="pill-btn" onclick="onOpenGarage">ГАРАЖ</text>
        <text class="pill-btn" onclick="onOpenSettings">ОПЦИИ</text>
      </div>
    </div>

    <div class="overlay-screen" if="{{ showPause }}">
      <text class="overlay-title">ПАУЗА</text>
      <text class="overlay-sub">СЧЕТ: {{ score }}  |  РЕКОРД: {{ bestScore }}</text>
      <text class="primary-btn" onclick="onResumeTap">ПРОДОЛЖИТЬ</text>
      <text class="secondary-btn" onclick="onRetryTap">ЗАНОВО</text>
      <text class="secondary-btn" onclick="onOpenGarage">ГАРАЖ</text>
      <text class="secondary-btn" onclick="onOpenSettings">НАСТРОЙКИ</text>
    </div>

    <div class="overlay-screen" if="{{ showCrash }}">
      <text class="crash-badge" if="{{ isNewBest }}">НОВЫЙ РЕКОРД!</text>
      <text class="overlay-title">{{ crashTitle }}</text>
      <text class="crash-big-score">{{ score }}</text>
      <text class="overlay-sub">РЕКОРД: {{ bestScore }}  |  ◆ {{ gems }}</text>
      <text class="mission-box">{{ missionText }}</text>
      <text class="primary-btn" onclick="onRetryTap">ЕЩЕ РАЗ</text>
      <div class="crash-btn-row">
        <text class="small-btn" onclick="onOpenGarage">ГАРАЖ</text>
        <text class="small-btn" onclick="onOpenSettings">ОПЦИИ</text>
      </div>
    </div>

    <scroll class="scroll-window" scroll-y="true" if="{{ showGarage }}">
      <text class="cfg-title">ГАРАЖ</text>
      <text class="garage-gems">БАЛАНС: ◆ {{ gems }}</text>
      <div
        class="skin-card"
        for="{{ (idx, sk) in skinCards }}"
        onclick="onSelectSkin(idx)"
      >
        <image class="skin-preview" src="{{ sk.src }}"></image>
        <div class="skin-meta">
          <text class="skin-name" style="color: {{ sk.color }};">{{ sk.name }}</text>
          <text class="skin-status">{{ sk.statusText }}</text>
        </div>
      </div>
      <text class="primary-btn-wide" onclick="onCloseModals">В ЗАЕЗД</text>
    </scroll>

    <scroll class="scroll-window" scroll-y="true" if="{{ showSettings }}">
      <text class="cfg-title">НАСТРОЙКИ</text>
      <text class="primary-btn-wide" onclick="onCloseModals">ИГРАТЬ</text>
      <text class="cfg-btn" onclick="onCycleDifficulty">РЕЖИМ: {{ diffLabel }}</text>
      <text class="cfg-btn" onclick="onCycleObstacles">ТРАССА: {{ obsLabel }}</text>
      <text class="cfg-btn" onclick="onCycleColorMode">ЦВЕТ: {{ colorLabel }}</text>
      <text class="cfg-btn" onclick="onCycleZoom">МАСШТАБ: {{ zoomLabel }}</text>
      <text class="cfg-btn" onclick="onToggleSpin">ВРАЩЕНИЕ: {{ spinLabel }}</text>
      <text class="cfg-btn" onclick="onToggleVibro">ВИБРО: {{ vibroLabel }}</text>
      <text class="cfg-btn" onclick="onToggleFps">FPS: {{ fpsLabel }}</text>
      <text class="cfg-btn-warn" onclick="onResetBest">{{ resetLabel }}</text>
    </scroll>
  </stack>
</template>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import {
  createGameEngine,
  CHART_POINTS,
  VIEW_H,
  SKIN_DEFS,
  MISSION_DEFS
} from '../../common/engine.js'

const ROTATE_TABLE = new Array(360)
for (let d = 0; d < 360; d++) {
  ROTATE_TABLE[d] = JSON.stringify({ rotate: d + 'deg' })
}

let engineInstance = null
let loopTimer = null
let lastTickMs = 0
let fpsFrameCount = 0
let fpsWindowStartMs = 0
let lastScreenBrightness = true

let cacheBx = -999
let cacheBy = -999
let cacheDeg = -1
let cacheHaz0X = -80
let cacheHaz0Y = -80
let cacheHaz1X = -80
let cacheHaz1Y = -80
let cacheSawDeg = -1

const initialChartArray = new Array(CHART_POINTS)
for (let i = 0; i < CHART_POINTS; i++) {
  initialChartArray[i] = 110
}

const sharedDataset = {
  strokeColor: '#FF1868',
  gradient: false,
  data: initialChartArray
}

const sharedLineData = [sharedDataset]

export default {
  private: {
    score: 0,
    bestScore: 0,
    prevBestAtStart: 0,
    isNewBest: false,
    gems: 0,
    infoText: 'РЕКОРД 0',
    bannerColor: '#9AA8B8',
    missionText: 'МИССИЯ: НАБЕРИ 15 ОЧКОВ',
    fpsText: '30 FPS',
    isHolding: false,
    isMenuState: true,
    isPlayingState: false,
    isCrashing: false,
    showFlash: false,
    showPause: false,
    showCrash: false,
    showGarage: false,
    showSettings: false,
    crashTitle: 'РАЗБИЛСЯ!',
    vibroEnabled: true,
    vibroLabel: 'ВКЛ',
    turboSpin: false,
    spinLabel: 'НОРМ',
    zoomMode: 0,
    zoomLabel: 'АВТО',
    difficultyMode: 0,
    diffLabel: 'КЛАССИКА',
    obstacleMode: 0,
    obsLabel: 'ВСЕ',
    colorMode: 0,
    colorLabel: 'РАДУГА',
    showFps: true,
    fpsLabel: 'ВКЛ',
    resetStep: 0,
    resetLabel: 'СБРОС ПРОГРЕССА',
    selectedSkin: 0,
    unlockedSkins: [true, false, false, false, false],
    skinCards: [],
    bikeSrc: '/common/bike_0.png',
    bikeStyle: { left: '30px', top: '126px', transform: ROTATE_TABLE[0] },
    saw0Style: { left: '-80px', top: '-80px', transform: ROTATE_TABLE[0] },
    saw1Style: { left: '-80px', top: '-80px', transform: ROTATE_TABLE[0] },
    boost0X: -80,
    boost0Y: -80,
    boost1X: -80,
    boost1Y: -80,
    gem0X: -80,
    gem0Y: -80,
    gem1X: -80,
    gem1Y: -80,
    gem2X: -80,
    gem2Y: -80,
    pit0X: -80,
    pit0W: 0,
    pit1X: -80,
    pit1W: 0,
    s0X: -80,
    s0Y: -80,
    s1X: -80,
    s1Y: -80,
    s2X: -80,
    s2Y: -80,
    s3X: -80,
    s3Y: -80,
    popupActive: false,
    popupText: '',
    popX: -80,
    popY: -80,
    lineOpts: {
      xAxis: {
        min: 0,
        max: 14,
        axisTick: 14,
        display: false
      },
      yAxis: {
        min: 0,
        max: VIEW_H,
        axisTick: 6,
        display: false
      },
      series: {
        lineStyle: {
          width: '3px',
          smooth: false
        }
      }
    },
    lineData: sharedLineData
  },

  onInit() {
    engineInstance = createGameEngine(Date.now() & 0xffffffff)
    cacheBx = -999
    cacheBy = -999
    cacheDeg = -1
    cacheHaz0X = -80
    cacheHaz0Y = -80
    cacheHaz1X = -80
    cacheHaz1Y = -80
    cacheSawDeg = -1
    this.rebuildSkinCards()
    this.updateMissionLabel()
    this.syncView(engineInstance.getRenderSnapshot(), true)
    this.loadSavedData()
  },

  onShow() {
    this.setScreenAwake(true)
    if (
      engineInstance &&
      (engineInstance.state.status === 'playing' || engineInstance.state.status === 'crashing') &&
      !this.showPause &&
      !this.showCrash &&
      !this.showGarage &&
      !this.showSettings
    ) {
      this.startLoop()
    }
  },

  onHide() {
    this.isHolding = false
    if (engineInstance && engineInstance.state.status === 'playing') {
      engineInstance.state.status = 'paused'
      this.showPause = true
      this.isPlayingState = false
    }
    this.stopLoop()
    this.saveProgress()
  },

  onDestroy() {
    this.stopLoop()
    this.saveProgress()
    this.setScreenAwake(false)
  },

  setScreenAwake(on) {
    try {
      if (lastScreenBrightness === on && !on) return
      lastScreenBrightness = on
      if (brightness && typeof brightness.setKeepScreenOn === 'function') {
        brightness.setKeepScreenOn({ keepScreenOn: on })
      }
    } catch (e) {}
  },

  applyEngineSettings() {
    if (!engineInstance) return
    engineInstance.state.turboFlip = this.turboSpin
    engineInstance.state.zoomMode = this.zoomMode
    engineInstance.state.zoomScale =
      this.zoomMode === 0 ? 1.0 : this.zoomMode === 1 ? 0.75 : 1.2
    engineInstance.state.difficultyMode = this.difficultyMode
    engineInstance.state.obstacleMode = this.obstacleMode
    engineInstance.state.colorMode = this.colorMode
    this.bikeSrc = '/common/bike_' + this.selectedSkin + '.png'
  },

  rebuildSkinCards() {
    const list = []
    for (let i = 0; i < SKIN_DEFS.length; i++) {
      const def = SKIN_DEFS[i]
      const owned = Boolean(this.unlockedSkins[i])
      const active = this.selectedSkin === i
      list.push({
        id: i,
        name: def.name,
        color: def.color,
        src: '/common/bike_' + i + '.png',
        statusText: active
          ? 'ВЫБРАНО'
          : owned
          ? 'НАЖМИ ЧТОБЫ ВЫБРАТЬ'
          : 'КУПИТЬ: ◆ ' + def.price
      })
    }
    this.skinCards = list
  },

  updateMissionLabel() {
    if (!engineInstance) return
    const m = MISSION_DEFS[engineInstance.state.missionIndex % MISSION_DEFS.length]
    this.missionText = 'МИССИЯ: ' + m.text + ' (+' + m.reward + '◆)'
  },

  applySavedPayload(parsed) {
    if (!parsed || typeof parsed !== 'object') return
    if (typeof parsed.best === 'number') {
      this.bestScore = parsed.best
      engineInstance.state.bestScore = parsed.best
    }
    if (typeof parsed.gems === 'number') {
      this.gems = parsed.gems
      engineInstance.state.gems = parsed.gems
    }
    if (typeof parsed.vibro === 'boolean') {
      this.vibroEnabled = parsed.vibro
      this.vibroLabel = parsed.vibro ? 'ВКЛ' : 'ВЫКЛ'
    }
    if (typeof parsed.turbo === 'boolean') {
      this.turboSpin = parsed.turbo
      this.spinLabel = parsed.turbo ? 'ТУРБО' : 'НОРМ'
    }
    if (typeof parsed.zoom === 'number') {
      this.zoomMode = parsed.zoom % 3
      this.zoomLabel =
        this.zoomMode === 0 ? 'АВТО' : this.zoomMode === 1 ? 'ДАЛЬНИЙ' : 'КРУПНЫЙ'
    }
    if (typeof parsed.diff === 'number') {
      this.difficultyMode = parsed.diff % 3
      this.diffLabel =
        this.difficultyMode === 0
          ? 'КЛАССИКА'
          : this.difficultyMode === 1
          ? 'АРКАДА'
          : 'ХАРДКОР'
    }
    if (typeof parsed.obs === 'number') {
      this.obstacleMode = parsed.obs % 3
      this.obsLabel =
        this.obstacleMode === 0
          ? 'ВСЕ'
          : this.obstacleMode === 1
          ? 'БЕЗ ПИЛ'
          : 'ФРИРАЙД'
    }
    if (typeof parsed.colorMode === 'number') {
      this.colorMode = parsed.colorMode % 5
      this.colorLabel =
        this.colorMode === 0
          ? 'РАДУГА'
          : this.colorMode === 1
          ? 'ЦИАН'
          : this.colorMode === 2
          ? 'ЛАЙМ'
          : this.colorMode === 3
          ? 'РОЗОВЫЙ'
          : 'ЗОЛОТО'
    }
    if (typeof parsed.showFps === 'boolean') {
      this.showFps = parsed.showFps
      this.fpsLabel = parsed.showFps ? 'ВКЛ' : 'ВЫКЛ'
    }
    if (typeof parsed.skin === 'number' && parsed.skin >= 0 && parsed.skin < SKIN_DEFS.length) {
      this.selectedSkin = parsed.skin
    }
    if (Array.isArray(parsed.skins)) {
      const next = [true, false, false, false, false]
      for (let i = 1; i < SKIN_DEFS.length; i++) {
        next[i] = Boolean(parsed.skins[i])
      }
      this.unlockedSkins = next
    }
    if (typeof parsed.mission === 'number') {
      engineInstance.state.missionIndex = parsed.mission % MISSION_DEFS.length
    }
    this.applyEngineSettings()
    engineInstance.resetWorld()
    this.rebuildSkinCards()
    this.updateMissionLabel()
    this.syncView(engineInstance.getRenderSnapshot(), true)
  },

  loadSavedData() {
    try {
      storage.get({
        key: 'com_band_rider_v2',
        success: (data) => {
          if (data) {
            try {
              this.applySavedPayload(JSON.parse(data))
              return
            } catch (e) {}
          }
          try {
            storage.get({
              key: 'com_band_rider_v14',
              success: (legacy) => {
                if (legacy) {
                  try {
                    const p = JSON.parse(legacy)
                    this.applySavedPayload({ best: p.best || 0, gems: p.gems || 0 })
                  } catch (e) {}
                }
              }
            })
          } catch (e) {}
        }
      })
    } catch (e) {}
  },

  saveProgress() {
    try {
      storage.set({
        key: 'com_band_rider_v2',
        value: JSON.stringify({
          best: this.bestScore,
          gems: this.gems,
          vibro: this.vibroEnabled,
          turbo: this.turboSpin,
          zoom: this.zoomMode,
          diff: this.difficultyMode,
          obs: this.obstacleMode,
          colorMode: this.colorMode,
          showFps: this.showFps,
          skin: this.selectedSkin,
          skins: this.unlockedSkins,
          mission: engineInstance ? engineInstance.state.missionIndex : 0
        })
      })
    } catch (e) {}
  },

  pulseHaptic(mode) {
    if (!this.vibroEnabled) return
    try {
      if (vibrator && typeof vibrator.vibrate === 'function') {
        vibrator.vibrate({ mode: mode || 'short' })
      }
    } catch (e) {}
  },

  startLoop() {
    this.stopLoop()
    const nowInit = Date.now()
    lastTickMs = nowInit
    fpsWindowStartMs = nowInit
    fpsFrameCount = 0

    const tick = () => {
      loopTimer = null
      if (!engineInstance || this.showPause || this.showGarage || this.showSettings || this.showCrash) {
        return
      }
      const st = engineInstance.state.status
      if (st !== 'playing' && st !== 'crashing') return

      const now = Date.now()
      const dt = (now - lastTickMs) * 0.001
      lastTickMs = now

      if (this.showFps) {
        fpsFrameCount += 1
        const elapsedFps = now - fpsWindowStartMs
        if (elapsedFps >= 750) {
          const currentFps = Math.min(60, Math.round((fpsFrameCount * 1000) / elapsedFps))
          const nextFps = currentFps + ' FPS'
          if (this.fpsText !== nextFps) this.fpsText = nextFps
          fpsFrameCount = 0
          fpsWindowStartMs = now
        }
      }

      const res = engineInstance.step(dt, this.isHolding)
      this.syncView(engineInstance.getRenderSnapshot(), false)

      if (res.event === 'flip' || res.event === 'gem' || res.event === 'land' || res.event === 'boost') {
        this.pulseHaptic('short')
      } else if (res.event === 'perfect' || res.event === 'mission') {
        this.updateMissionLabel()
        this.pulseHaptic('short')
      } else if (res.event === 'crash') {
        this.isHolding = false
        this.pulseHaptic('long')
        this.saveProgress()
      } else if (res.event === 'gameover') {
        this.isHolding = false
        this.isPlayingState = false
        this.isCrashing = false
        this.showFlash = false
        this.showCrash = true
        this.crashTitle = engineInstance.state.crashReason || 'РАЗБИЛСЯ!'
        this.isNewBest = this.score > 0 && this.score > this.prevBestAtStart
        this.updateMissionLabel()
        this.saveProgress()
        return
      }

      const workMs = Date.now() - now
      loopTimer = setTimeout(tick, Math.max(1, 16 - workMs))
    }
    loopTimer = setTimeout(tick, 16)
  },

  stopLoop() {
    if (loopTimer !== null) {
      clearTimeout(loopTimer)
      loopTimer = null
    }
  },

  syncView(snap, forceChart) {
    const activePlay = snap.status === 'playing' || snap.status === 'crashing'
    if (forceChart || activePlay) {
      sharedDataset.strokeColor = snap.trackColor
      sharedDataset.data = snap.chartData
      this.lineData = sharedLineData
    }

    const b = snap.bike
    if (b.bx !== cacheBx || b.by !== cacheBy || b.deg !== cacheDeg) {
      cacheBx = b.bx
      cacheBy = b.by
      cacheDeg = b.deg
      this.bikeStyle = {
        left: b.bx + 'px',
        top: b.by + 'px',
        transform: ROTATE_TABLE[b.deg]
      }
    }

    const sawRot = ROTATE_TABLE[snap.sawAngleDeg]
    const sawDegChanged = snap.sawAngleDeg !== cacheSawDeg
    if (snap.haz0X > -40 || cacheHaz0X > -40) {
      if (snap.haz0X !== cacheHaz0X || snap.haz0Y !== cacheHaz0Y || sawDegChanged) {
        cacheHaz0X = snap.haz0X
        cacheHaz0Y = snap.haz0Y
        this.saw0Style = { left: snap.haz0X + 'px', top: snap.haz0Y + 'px', transform: sawRot }
      }
    }
    if (snap.haz1X > -40 || cacheHaz1X > -40) {
      if (snap.haz1X !== cacheHaz1X || snap.haz1Y !== cacheHaz1Y || sawDegChanged) {
        cacheHaz1X = snap.haz1X
        cacheHaz1Y = snap.haz1Y
        this.saw1Style = { left: snap.haz1X + 'px', top: snap.haz1Y + 'px', transform: sawRot }
      }
    }
    cacheSawDeg = snap.sawAngleDeg

    if (this.boost0X !== snap.boost0X) this.boost0X = snap.boost0X
    if (this.boost0Y !== snap.boost0Y) this.boost0Y = snap.boost0Y
    if (this.boost1X !== snap.boost1X) this.boost1X = snap.boost1X
    if (this.boost1Y !== snap.boost1Y) this.boost1Y = snap.boost1Y

    if (this.gem0X !== snap.gem0X) this.gem0X = snap.gem0X
    if (this.gem0Y !== snap.gem0Y) this.gem0Y = snap.gem0Y
    if (this.gem1X !== snap.gem1X) this.gem1X = snap.gem1X
    if (this.gem1Y !== snap.gem1Y) this.gem1Y = snap.gem1Y
    if (this.gem2X !== snap.gem2X) this.gem2X = snap.gem2X
    if (this.gem2Y !== snap.gem2Y) this.gem2Y = snap.gem2Y

    if (this.pit0X !== snap.pit0X) this.pit0X = snap.pit0X
    if (this.pit0W !== snap.pit0W) this.pit0W = snap.pit0W
    if (this.pit1X !== snap.pit1X) this.pit1X = snap.pit1X
    if (this.pit1W !== snap.pit1W) this.pit1W = snap.pit1W

    const crashingNow = snap.status === 'crashing'
    if (this.isCrashing !== crashingNow) this.isCrashing = crashingNow
    if (crashingNow || this.s0X > -40) {
      const deb = snap.debris
      if (this.s0X !== deb[0].sx) this.s0X = deb[0].sx
      if (this.s0Y !== deb[0].sy) this.s0Y = deb[0].sy
      if (this.s1X !== deb[1].sx) this.s1X = deb[1].sx
      if (this.s1Y !== deb[1].sy) this.s1Y = deb[1].sy
      if (this.s2X !== deb[2].sx) this.s2X = deb[2].sx
      if (this.s2Y !== deb[2].sy) this.s2Y = deb[2].sy
      if (this.s3X !== deb[3].sx) this.s3X = deb[3].sx
      if (this.s3Y !== deb[3].sy) this.s3Y = deb[3].sy
    }

    if (this.popupActive !== snap.popupActive) this.popupActive = snap.popupActive
    if (snap.popupActive) {
      if (this.popupText !== snap.popupText) this.popupText = snap.popupText
      if (this.popX !== snap.popupSX) this.popX = snap.popupSX
      if (this.popY !== snap.popupSY) this.popY = snap.popupSY
    }

    const flashNow = snap.crashFlash > 0.35
    if (this.showFlash !== flashNow) this.showFlash = flashNow

    if (this.score !== snap.score) this.score = snap.score
    if (this.bestScore !== snap.bestScore) this.bestScore = snap.bestScore
    if (this.gems !== snap.gems) this.gems = snap.gems

    const nextInfo = snap.bannerText
      ? snap.bannerText
      : b.sawAhead
      ? 'ПИЛА ВПЕРЕДИ!'
      : snap.combo > 1
      ? 'КОМБО x' + snap.combo
      : 'РЕКОРД ' + snap.bestScore
    if (this.infoText !== nextInfo) this.infoText = nextInfo

    const nextColor = snap.bannerText
      ? snap.trackColor
      : b.sawAhead
      ? '#FF2E4C'
      : snap.combo > 1
      ? '#00F564'
      : '#9AA8B8'
    if (this.bannerColor !== nextColor) this.bannerColor = nextColor
  },

  beginNewRun(holdRightNow) {
    if (!engineInstance) return
    this.prevBestAtStart = this.bestScore
    this.isNewBest = false
    this.isMenuState = false
    this.isPlayingState = true
    this.showPause = false
    this.showCrash = false
    this.showGarage = false
    this.showSettings = false
    this.applyEngineSettings()
    engineInstance.startGame()
    this.updateMissionLabel()
    this.syncView(engineInstance.getRenderSnapshot(), true)
    this.isHolding = Boolean(holdRightNow)
    this.pulseHaptic('short')
    this.startLoop()
  },

  onScreenHoldStart() {
    if (!engineInstance || this.showPause || this.showCrash || this.showGarage || this.showSettings) {
      return
    }
    if (engineInstance.state.status === 'menu') {
      this.beginNewRun(true)
      return
    }
    if (engineInstance.state.status === 'playing') {
      this.isHolding = true
    }
  },

  onScreenHoldEnd() {
    this.isHolding = false
  },

  onPauseTap() {
    if (!engineInstance || engineInstance.state.status !== 'playing') return
    this.isHolding = false
    this.stopLoop()
    engineInstance.state.status = 'paused'
    this.isPlayingState = false
    this.showPause = true
    this.pulseHaptic('short')
  },

  onResumeTap() {
    if (!engineInstance) return
    this.showPause = false
    this.isPlayingState = true
    engineInstance.state.status = 'playing'
    this.pulseHaptic('short')
    this.startLoop()
  },

  onRetryTap() {
    this.beginNewRun(false)
  },

  onOpenGarage() {
    this.isHolding = false
    this.stopLoop()
    this.showPause = false
    this.showCrash = false
    this.showSettings = false
    this.rebuildSkinCards()
    this.showGarage = true
    this.pulseHaptic('short')
  },

  onOpenSettings() {
    this.isHolding = false
    this.stopLoop()
    this.resetStep = 0
    this.resetLabel = 'СБРОС ПРОГРЕССА'
    this.showPause = false
    this.showCrash = false
    this.showGarage = false
    this.showSettings = true
    this.pulseHaptic('short')
  },

  onCloseModals() {
    this.beginNewRun(false)
  },

  onSelectSkin(idx) {
    if (idx < 0 || idx >= SKIN_DEFS.length) return
    if (this.unlockedSkins[idx]) {
      this.selectedSkin = idx
      this.applyEngineSettings()
      this.rebuildSkinCards()
      this.pulseHaptic('short')
      this.saveProgress()
      return
    }
    const price = SKIN_DEFS[idx].price
    if (this.gems >= price) {
      this.gems -= price
      if (engineInstance) engineInstance.state.gems = this.gems
      const next = this.unlockedSkins.slice()
      next[idx] = true
      this.unlockedSkins = next
      this.selectedSkin = idx
      this.applyEngineSettings()
      this.rebuildSkinCards()
      this.pulseHaptic('long')
      this.saveProgress()
    } else {
      this.pulseHaptic('short')
    }
  },

  onCycleZoom() {
    this.zoomMode = (this.zoomMode + 1) % 3
    this.zoomLabel =
      this.zoomMode === 0 ? 'АВТО' : this.zoomMode === 1 ? 'ДАЛЬНИЙ' : 'КРУПНЫЙ'
    this.applyEngineSettings()
    this.syncView(engineInstance.getRenderSnapshot(), true)
    this.pulseHaptic('short')
    this.saveProgress()
  },

  onCycleDifficulty() {
    this.difficultyMode = (this.difficultyMode + 1) % 3
    this.diffLabel =
      this.difficultyMode === 0
        ? 'КЛАССИКА'
        : this.difficultyMode === 1
        ? 'АРКАДА'
        : 'ХАРДКОР'
    this.applyEngineSettings()
    this.pulseHaptic('short')
    this.saveProgress()
  },

  onCycleObstacles() {
    this.obstacleMode = (this.obstacleMode + 1) % 3
    this.obsLabel =
      this.obstacleMode === 0
        ? 'ВСЕ'
        : this.obstacleMode === 1
        ? 'БЕЗ ПИЛ'
        : 'ФРИРАЙД'
    this.applyEngineSettings()
    this.pulseHaptic('short')
    this.saveProgress()
  },

  onCycleColorMode() {
    this.colorMode = (this.colorMode + 1) % 5
    this.colorLabel =
      this.colorMode === 0
        ? 'РАДУГА'
        : this.colorMode === 1
        ? 'ЦИАН'
        : this.colorMode === 2
        ? 'ЛАЙМ'
        : this.colorMode === 3
        ? 'РОЗОВЫЙ'
        : 'ЗОЛОТО'
    this.applyEngineSettings()
    this.syncView(engineInstance.getRenderSnapshot(), true)
    this.pulseHaptic('short')
    this.saveProgress()
  },

  onToggleSpin() {
    this.turboSpin = !this.turboSpin
    this.spinLabel = this.turboSpin ? 'ТУРБО' : 'НОРМ'
    this.applyEngineSettings()
    this.pulseHaptic('short')
    this.saveProgress()
  },

  onToggleVibro() {
    this.vibroEnabled = !this.vibroEnabled
    this.vibroLabel = this.vibroEnabled ? 'ВКЛ' : 'ВЫКЛ'
    if (this.vibroEnabled) this.pulseHaptic('short')
    this.saveProgress()
  },

  onToggleFps() {
    this.showFps = !this.showFps
    this.fpsLabel = this.showFps ? 'ВКЛ' : 'ВЫКЛ'
    this.pulseHaptic('short')
    this.saveProgress()
  },

  onResetBest() {
    if (this.resetStep === 0) {
      this.resetStep = 1
      this.resetLabel = 'ТОЧНО СБРОСИТЬ?'
      this.pulseHaptic('short')
      return
    }
    this.resetStep = 0
    this.bestScore = 0
    this.gems = 0
    this.selectedSkin = 0
    this.unlockedSkins = [true, false, false, false, false]
    this.resetLabel = 'СБРОШЕНО!'
    if (engineInstance) {
      engineInstance.state.bestScore = 0
      engineInstance.state.gems = 0
      engineInstance.state.missionIndex = 0
      this.syncView(engineInstance.getRenderSnapshot(), false)
    }
    this.applyEngineSettings()
    this.rebuildSkinCards()
    this.updateMissionLabel()
    this.pulseHaptic('long')
    this.saveProgress()
  }
}
</script>

