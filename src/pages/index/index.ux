<template>
  <stack class="screen">
    <div class="game-layout">
      <div
        class="touch-zone"
        ontouchstart="onScreenHoldStart"
        ontouchend="onScreenHoldEnd"
        ontouchcancel="onScreenHoldEnd"
      >
        <div class="hud-top">
          <text class="hud-score">{{ score }}</text>
          <text class="hud-info">{{ infoText }}</text>
        </div>

        <stack class="viewport">
          <chart
            class="track-chart"
            type="line"
            options="{{ lineOpts }}"
            datasets="{{ lineData }}"
          ></chart>

          <div class="sprite-layer">
            <div
              class="loop-node"
              style="left: {{ loopX }}px; top: {{ loopY }}px; border-color: {{ trackColor }};"
            ></div>
            <div
              class="saw-node"
              style="left: {{ hazX }}px; top: {{ hazY }}px; border-color: {{ sawColor }};"
            ></div>
            <div
              class="gem-node"
              style="left: {{ gemX }}px; top: {{ gemY }}px;"
            ></div>
            <div
              class="bike-wheel"
              style="left: {{ rx }}px; top: {{ ry }}px; border-color: {{ trackColor }};"
            ></div>
            <div
              class="bike-wheel"
              style="left: {{ fx }}px; top: {{ fy }}px; border-color: {{ trackColor }};"
            ></div>
            <div
              class="bike-core"
              style="left: {{ cx }}px; top: {{ cy }}px; border-color: {{ trackColor }};"
            ></div>
          </div>
        </stack>
      </div>

      <div class="bottom-bar">
        <text class="menu-btn" onclick="onOpenSettings">МЕНЮ</text>
        <text class="fps-counter" if="{{ showFps }}">{{ fpsText }}</text>
      </div>
    </div>

    <div class="overlay-screen" if="{{ showCrash }}">
      <text class="crash-title">{{ crashTitle }}</text>
      <text class="crash-stat">СЧЕТ: {{ score }}</text>
      <text class="crash-best">РЕКОРД: {{ bestScore }}  |  КРИСТ: {{ gems }}</text>
      <text class="retry-btn" onclick="onRetryTap">ПОВТОРИТЬ</text>
      <text class="sub-btn" onclick="onOpenSettings">НАСТРОЙКИ</text>
    </div>

    <div class="overlay-screen" if="{{ showSettings }}">
      <text class="cfg-title">НАСТРОЙКИ</text>
      <text class="cfg-item" onclick="onToggleVibro">ВИБРО: {{ vibroLabel }}</text>
      <text class="cfg-item" onclick="onToggleSpin">ВРАЩЕНИЕ: {{ spinLabel }}</text>
      <text class="cfg-item" onclick="onToggleCam">КАМЕРА: {{ camLabel }}</text>
      <text class="cfg-item" onclick="onToggleFps">ПОКАЗ FPS: {{ fpsLabel }}</text>
      <text class="cfg-item-warn" onclick="onResetBest">{{ resetLabel }}</text>
      <text class="retry-btn" onclick="onCloseSettings">ИГРАТЬ</text>
    </div>
  </stack>
</template>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import { createGameEngine } from '../../common/engine.js'

let engineInstance = null
let loopTimer = null
let lastTickMs = 0
let fpsFrameCount = 0
let fpsWindowStartMs = 0

const sharedDataset = {
  strokeColor: '#FF1844',
  fillColor: '#000000',
  gradient: false,
  data: [140, 140, 140, 140, 140, 140, 140, 140, 140, 140, 140]
}

export default {
  private: {
    score: 0,
    bestScore: 0,
    gems: 0,
    infoText: 'НАЖМИ ЧТОБЫ НАЧАТЬ',
    fpsText: 'READY',
    trackColor: '#FF1844',
    sawColor: '#FF1744',
    isHolding: false,
    showCrash: false,
    showSettings: false,
    crashTitle: 'РАЗБИЛСЯ!',
    vibroEnabled: true,
    vibroLabel: 'ВКЛ',
    turboSpin: false,
    spinLabel: 'НОРМ',
    farCam: false,
    camLabel: 'БЛИЗКО',
    showFps: true,
    fpsLabel: 'ВКЛ',
    resetLabel: 'СБРОС РЕКОРДА',
    rx: 34,
    ry: 168,
    cx: 44,
    cy: 164,
    fx: 54,
    fy: 168,
    gemX: -40,
    gemY: -40,
    hazX: -50,
    hazY: -50,
    loopX: -140,
    loopY: -140,
    lineOpts: {
      xAxis: {
        min: 0,
        max: 10,
        axisTick: 10,
        display: false
      },
      yAxis: {
        min: 0,
        max: 300,
        axisTick: 6,
        display: false
      },
      series: {
        lineStyle: {
          width: '3px',
          smooth: false
        }
      }
    },
    lineData: [sharedDataset]
  },

  onInit() {
    engineInstance = createGameEngine(Date.now() & 0xffffffff)
    this.syncView(engineInstance.getRenderSnapshot(), true)
    this.loadSavedData()
  },

  onShow() {
    try {
      if (brightness && typeof brightness.setKeepScreenOn === 'function') {
        brightness.setKeepScreenOn({ keepScreenOn: true })
      }
    } catch (e) {}
    if (
      engineInstance &&
      engineInstance.state.status === 'playing' &&
      !this.showCrash &&
      !this.showSettings
    ) {
      this.startLoop()
    }
  },

  onHide() {
    this.isHolding = false
    this.stopLoop()
  },

  onDestroy() {
    this.stopLoop()
    try {
      if (brightness && typeof brightness.setKeepScreenOn === 'function') {
        brightness.setKeepScreenOn({ keepScreenOn: false })
      }
    } catch (e) {}
  },

  loadSavedData() {
    try {
      storage.get({
        key: 'rider_band10_v7',
        success: (data) => {
          if (data) {
            try {
              const parsed = JSON.parse(data)
              if (typeof parsed.best === 'number') {
                this.bestScore = parsed.best
                engineInstance.state.bestScore = parsed.best
              }
              if (typeof parsed.gems === 'number') {
                this.gems = parsed.gems
                engineInstance.state.gems = parsed.gems
              }
              if (typeof parsed.vibro === 'boolean') {
                this.vibroEnabled = parsed.vibro
                this.vibroLabel = parsed.vibro ? 'ВКЛ' : 'ВЫКЛ'
              }
              if (typeof parsed.turbo === 'boolean') {
                this.turboSpin = parsed.turbo
                this.spinLabel = parsed.turbo ? 'ТУРБО' : 'НОРМ'
                engineInstance.state.turboFlip = parsed.turbo
              }
              if (typeof parsed.farCam === 'boolean') {
                this.farCam = parsed.farCam
                this.camLabel = parsed.farCam ? 'ДАЛЕКО' : 'БЛИЗКО'
                engineInstance.state.farCam = parsed.farCam
              }
              if (typeof parsed.showFps === 'boolean') {
                this.showFps = parsed.showFps
                this.fpsLabel = parsed.showFps ? 'ВКЛ' : 'ВЫКЛ'
              }
              this.syncView(engineInstance.getRenderSnapshot(), true)
            } catch (e) {}
          }
        }
      })
    } catch (e) {}
  },

  saveProgress() {
    try {
      storage.set({
        key: 'rider_band10_v7',
        value: JSON.stringify({
          best: this.bestScore,
          gems: this.gems,
          vibro: this.vibroEnabled,
          turbo: this.turboSpin,
          farCam: this.farCam,
          showFps: this.showFps
        })
      })
    } catch (e) {}
  },

  pulseHaptic(mode) {
    if (!this.vibroEnabled) return
    try {
      if (vibrator && typeof vibrator.vibrate === 'function') {
        vibrator.vibrate({ mode: mode || 'short' })
      }
    } catch (e) {}
  },

  startLoop() {
    this.stopLoop()
    const nowInit = Date.now()
    lastTickMs = nowInit
    fpsWindowStartMs = nowInit
    fpsFrameCount = 0

    const tick = () => {
      loopTimer = null
      if (!engineInstance || this.showSettings || this.showCrash) return
      if (engineInstance.state.status !== 'playing') return

      const now = Date.now()
      const dt = (now - lastTickMs) * 0.001
      lastTickMs = now

      if (this.showFps) {
        fpsFrameCount += 1
        const elapsedFps = now - fpsWindowStartMs
        if (elapsedFps >= 800) {
          const currentFps = Math.min(60, Math.round((fpsFrameCount * 1000) / elapsedFps))
          const nextFpsText = currentFps + ' FPS'
          if (this.fpsText !== nextFpsText) {
            this.fpsText = nextFpsText
          }
          fpsFrameCount = 0
          fpsWindowStartMs = now
        }
      }

      const res = engineInstance.step(dt, this.isHolding)
      this.syncView(engineInstance.getRenderSnapshot(), false)

      if (res.event === 'flip' || res.event === 'gem' || res.event === 'land') {
        this.pulseHaptic('short')
      } else if (res.event === 'crash') {
        this.isHolding = false
        this.showCrash = true
        this.crashTitle = engineInstance.state.crashReason || 'РАЗБИЛСЯ!'
        this.pulseHaptic('long')
        this.saveProgress()
        return
      }

      loopTimer = setTimeout(tick, 10)
    }
    loopTimer = setTimeout(tick, 10)
  },

  stopLoop() {
    if (loopTimer !== null) {
      clearTimeout(loopTimer)
      loopTimer = null
    }
  },

  syncView(snap, forceChart) {
    if (forceChart || snap.status === 'playing') {
      sharedDataset.strokeColor = snap.trackColor
      sharedDataset.gradient = false
      sharedDataset.data = snap.chartData
      this.lineData = [sharedDataset]
    }

    if (this.trackColor !== snap.trackColor) this.trackColor = snap.trackColor
    if (this.sawColor !== snap.sawColor) this.sawColor = snap.sawColor

    const b = snap.bike
    if (this.rx !== b.rx) this.rx = b.rx
    if (this.ry !== b.ry) this.ry = b.ry
    if (this.cx !== b.cx) this.cx = b.cx
    if (this.cy !== b.cy) this.cy = b.cy
    if (this.fx !== b.fx) this.fx = b.fx
    if (this.fy !== b.fy) this.fy = b.fy

    if (this.gemX !== snap.gemX) this.gemX = snap.gemX
    if (this.gemY !== snap.gemY) this.gemY = snap.gemY
    if (this.hazX !== snap.hazX) this.hazX = snap.hazX
    if (this.hazY !== snap.hazY) this.hazY = snap.hazY
    if (this.loopX !== snap.loopX) this.loopX = snap.loopX
    if (this.loopY !== snap.loopY) this.loopY = snap.loopY

    if (this.score !== snap.score) this.score = snap.score
    if (this.bestScore !== snap.bestScore) this.bestScore = snap.bestScore
    if (this.gems !== snap.gems) this.gems = snap.gems

    const nextInfo = snap.bannerText
      ? snap.bannerText
      : 'РЕКОРД ' + snap.bestScore + '  |  КРИСТ ' + snap.gems
    if (this.infoText !== nextInfo) {
      this.infoText = nextInfo
    }
  },

  onScreenHoldStart() {
    if (!engineInstance || this.showSettings || this.showCrash) return
    if (engineInstance.state.status !== 'playing') {
      engineInstance.startGame()
      this.syncView(engineInstance.getRenderSnapshot(), true)
      this.pulseHaptic('short')
      this.startLoop()
    }
    this.isHolding = true
  },

  onScreenHoldEnd() {
    this.isHolding = false
  },

  onRetryTap() {
    if (!engineInstance) return
    this.showCrash = false
    this.showSettings = false
    engineInstance.startGame()
    this.syncView(engineInstance.getRenderSnapshot(), true)
    this.pulseHaptic('short')
    this.startLoop()
  },

  onOpenSettings() {
    this.isHolding = false
    this.stopLoop()
    this.resetLabel = 'СБРОС РЕКОРДА'
    this.showSettings = true
    this.pulseHaptic('short')
  },

  onCloseSettings() {
    this.showSettings = false
    this.syncView(engineInstance.getRenderSnapshot(), true)
    this.pulseHaptic('short')
    if (engineInstance && engineInstance.state.status === 'playing' && !this.showCrash) {
      this.startLoop()
    }
  },

  onToggleVibro() {
    this.vibroEnabled = !this.vibroEnabled
    this.vibroLabel = this.vibroEnabled ? 'ВКЛ' : 'ВЫКЛ'
    if (this.vibroEnabled) this.pulseHaptic('short')
    this.saveProgress()
  },

  onToggleSpin() {
    this.turboSpin = !this.turboSpin
    this.spinLabel = this.turboSpin ? 'ТУРБО' : 'НОРМ'
    if (engineInstance) {
      engineInstance.state.turboFlip = this.turboSpin
    }
    this.pulseHaptic('short')
    this.saveProgress()
  },

  onToggleCam() {
    this.farCam = !this.farCam
    this.camLabel = this.farCam ? 'ДАЛЕКО' : 'БЛИЗКО'
    if (engineInstance) {
      engineInstance.state.farCam = this.farCam
      this.syncView(engineInstance.getRenderSnapshot(), true)
    }
    this.pulseHaptic('short')
    this.saveProgress()
  },

  onToggleFps() {
    this.showFps = !this.showFps
    this.fpsLabel = this.showFps ? 'ВКЛ' : 'ВЫКЛ'
    this.pulseHaptic('short')
    this.saveProgress()
  },

  onResetBest() {
    this.bestScore = 0
    this.gems = 0
    this.resetLabel = 'СБРОШЕНО!'
    if (engineInstance) {
      engineInstance.state.bestScore = 0
      engineInstance.state.gems = 0
      this.syncView(engineInstance.getRenderSnapshot(), false)
    }
    this.pulseHaptic('long')
    this.saveProgress()
  }
}
</script>

<style>
.screen {
  width: 212px;
  height: 520px;
  background-color: #000000;
}

.game-layout {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  background-color: #000000;
}

.touch-zone {
  width: 212px;
  height: 410px;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  background-color: #000000;
}

.hud-top {
  width: 184px;
  height: 92px;
  margin-top: 14px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hud-score {
  font-size: 38px;
  color: #FFFFFF;
  text-align: center;
}

.hud-info {
  font-size: 14px;
  color: #CCCCCC;
  margin-top: 4px;
  text-align: center;
}

.viewport {
  width: 200px;
  height: 300px;
  background-color: #000000;
}

.track-chart {
  width: 200px;
  height: 300px;
}

.sprite-layer {
  width: 200px;
  height: 300px;
}

.bottom-bar {
  width: 212px;
  height: 108px;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  padding-top: 8px;
}

.menu-btn {
  width: 136px;
  height: 40px;
  border-radius: 20px;
  border-width: 2px;
  border-color: #FFFFFF;
  background-color: #121212;
  font-size: 16px;
  color: #FFFFFF;
  text-align: center;
}

.fps-counter {
  width: 100px;
  height: 20px;
  font-size: 13px;
  color: #777777;
  text-align: center;
  margin-top: 8px;
}

.loop-node {
  position: absolute;
  width: 88px;
  height: 88px;
  border-radius: 44px;
  border-width: 3px;
  border-color: #FF1844;
  background-color: rgba(0, 0, 0, 0);
}

.saw-node {
  position: absolute;
  width: 28px;
  height: 28px;
  border-radius: 14px;
  border-width: 5px;
  border-color: #FF1744;
  background-color: #2B0008;
}

.gem-node {
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 5px;
  background-color: #FFFFFF;
}

.bike-wheel {
  position: absolute;
  width: 12px;
  height: 12px;
  border-radius: 6px;
  border-width: 3px;
  border-color: #FF1844;
  background-color: #000000;
}

.bike-core {
  position: absolute;
  width: 12px;
  height: 10px;
  border-radius: 5px;
  border-width: 2px;
  border-color: #FF1844;
  background-color: #FFFFFF;
}

.overlay-screen {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 212px;
  height: 520px;
  background-color: #000000;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.crash-title {
  font-size: 26px;
  color: #FFFFFF;
  margin-bottom: 12px;
}

.crash-stat {
  font-size: 22px;
  color: #EAEAEA;
  margin-bottom: 6px;
}

.crash-best {
  font-size: 14px;
  color: #999999;
  margin-bottom: 26px;
}

.retry-btn {
  width: 164px;
  height: 50px;
  border-radius: 25px;
  border-width: 2px;
  border-color: #FFFFFF;
  background-color: #FFFFFF;
  font-size: 18px;
  color: #000000;
  text-align: center;
  margin-top: 8px;
}

.sub-btn {
  width: 152px;
  height: 44px;
  border-radius: 22px;
  border-width: 2px;
  border-color: #666666;
  background-color: #121212;
  font-size: 15px;
  color: #FFFFFF;
  text-align: center;
  margin-top: 12px;
}

.cfg-title {
  font-size: 22px;
  color: #FFFFFF;
  margin-bottom: 10px;
}

.cfg-item {
  width: 176px;
  height: 40px;
  border-radius: 20px;
  border-width: 2px;
  border-color: #555555;
  background-color: #101010;
  font-size: 14px;
  color: #FFFFFF;
  text-align: center;
  margin-top: 6px;
}

.cfg-item-warn {
  width: 176px;
  height: 38px;
  border-radius: 19px;
  border-width: 2px;
  border-color: #444444;
  background-color: #080808;
  font-size: 14px;
  color: #AAAAAA;
  text-align: center;
  margin-top: 8px;
  margin-bottom: 4px;
}
</style>
