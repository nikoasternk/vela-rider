  font-size: 14px;
  color: #00F0FF;
}

.banner-bar {
  width: 200px;
  height: 26px;
  justify-content: center;
  align-items: center;
}

.banner-text {
  font-size: 18px;
  color: #00F0FF;
}

.viewport {
  width: 210px;
  height: 300px;
  background-color: #000000;
}

.terrain-row {
  width: 210px;
  height: 300px;
  flex-direction: row;
}

.terrain-col {
  width: 10px;
  height: 300px;
  flex-direction: column;
}

.sky-slice {
  width: 10px;
  background-color: #000000;
}

.haz-slice {
  width: 10px;
  background-color: #FF1744;
  border-radius: 2px;
  border-width: 1px;
  border-color: #FFFFFF;
}

.surf-slice {
  width: 10px;
  border-radius: 2px;
}

.sub-slice {
  width: 10px;
}

.sprite-layer {
  width: 210px;
  height: 300px;
}

.bike-wheel {
  position: absolute;
  width: 12px;
  height: 12px;
  border-radius: 6px;
  border-width: 3px;
  background-color: #000000;
}

.bike-core {
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 5px;
  border-width: 2px;
}

.bike-visor {
  position: absolute;
  width: 8px;
  height: 8px;
  border-radius: 4px;
  border-width: 1px;
}

.gem-node {
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 5px;
  border-width: 2px;
}

.spark-node {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 3px;
}

.control-deck {
  width: 212px;
  height: 102px;
  justify-content: center;
  align-items: center;
}

.deck-btn {
  width: 184px;
  height: 76px;
  border-radius: 38px;
  border-width: 3px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.deck-title {
  font-size: 20px;
}

.deck-sub {
  font-size: 13px;
  color: #7C8B99;
  margin-top: 4px;
}
</style>
