<template>
  <stack class="screen">
    <div
      class="game-layout"
      ontouchstart="onScreenHoldStart"
      ontouchend="onScreenHoldEnd"
      ontouchcancel="onScreenHoldEnd"
    >
      <div class="hud-top">
        <div class="hud-row">
          <div class="hud-spacer"></div>
          <text class="hud-score">{{ score }}</text>
          <text class="cfg-btn" onclick="onOpenSettings">⚙</text>
        </div>
        <text class="hud-info" style="color: {{ accentColor }};">{{ infoText }}</text>
      </div>

      <stack class="viewport">
        <chart
          class="track-chart"
          type="line"
          options="{{ lineOpts }}"
          datasets="{{ lineData }}"
        ></chart>

        <div class="sprite-layer">
          <div class="haz-node" style="left: {{ hazX }}px; top: {{ hazY }}px;"></div>
          <div
            class="gem-node"
            style="left: {{ gemX }}px; top: {{ gemY }}px; background-color: {{ accentColor }};"
          ></div>
          <div
            class="bike-wheel"
            style="left: {{ rx }}px; top: {{ ry }}px; border-color: {{ trackColor }};"
          ></div>
          <div
            class="bike-wheel"
            style="left: {{ fx }}px; top: {{ fy }}px; border-color: {{ trackColor }};"
          ></div>
          <div
            class="bike-core"
            style="left: {{ cx }}px; top: {{ cy }}px; background-color: {{ bikeColor }}; border-color: {{ accentColor }};"
          ></div>
        </div>
      </stack>

      <div class="bottom-bar">
        <text class="fps-counter">{{ fpsText }}</text>
      </div>
    </div>

    <div class="overlay-screen" if="{{ showCrash }}">
      <text class="crash-title">{{ crashTitle }}</text>
      <text class="crash-stat">СЧЕТ: {{ score }}</text>
      <text class="crash-best">РЕКОРД: {{ bestScore }}   ◆ {{ gems }}</text>
      <text class="retry-btn" onclick="onRetryTap">ПОВТОРИТЬ</text>
      <text class="sub-btn" onclick="onOpenSettings">НАСТРОЙКИ</text>
    </div>

    <div class="overlay-screen" if="{{ showSettings }}">
      <text class="cfg-title">НАСТРОЙКИ</text>
      <text class="cfg-item" onclick="onToggleVibro">ВИБРО: {{ vibroLabel }}</text>
      <text class="cfg-item" onclick="onCycleFpsMode">ЧАСТОТА: {{ fpsModeLabel }}</text>
      <text class="cfg-item" onclick="onToggleFill">ТРАССА: {{ fillLabel }}</text>
      <text class="cfg-item" onclick="onToggleSpin">САЛЬТО: {{ spinLabel }}</text>
      <text class="cfg-item-warn" onclick="onResetBest">СБРОС РЕКОРДА</text>
      <text class="retry-btn" onclick="onCloseSettings">ИГРАТЬ</text>
    </div>
  </stack>
</template>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import brightness from '@system.brightness'
import { createGameEngine } from '../../common/engine.js'

let engineInstance = null
let loopTimer = null
let lastTickMs = 0
let fpsFrameCount = 0
let fpsWindowStartMs = 0

const sharedDataset = {
  strokeColor: '#00F0FF',
  fillColor: '#042230',
  gradient: false,
  data: [140, 140, 140, 140, 140, 140, 140, 140, 140, 140, 140]
}

export default {
  private: {
    score: 0,
    bestScore: 0,
    gems: 0,
    infoText: 'НАЖМИ ЧТОБЫ НАЧАТЬ',
    fpsText: 'READY',
    trackColor: '#00F0FF',
    bikeColor: '#FF006E',
    accentColor: '#FFD700',
    isHolding: false,
    showCrash: false,
    showSettings: false,
    crashTitle: 'РАЗБИЛСЯ!',
    vibroEnabled: true,
    vibroLabel: 'ВКЛ',
    fpsTargetMode: 0,
    fpsModeLabel: '60 ГЦ',
    fillEnabled: false,
    fillLabel: 'ЛИНИЯ',
    turboSpin: false,
    spinLabel: 'НОРМ',
    rx: 34,
    ry: 168,
    cx: 44,
    cy: 164,
    fx: 54,
    fy: 168,
    gemX: -30,
    gemY: -30,
    hazX: -30,
    hazY: -30,
    lineOpts: {
      xAxis: {
        min: 0,
        max: 10,
        axisTick: 10,
        display: false
      },
      yAxis: {
        min: 0,
        max: 300,
        axisTick: 6,
        display: false
      },
      series: {
        lineStyle: {
          width: '3px',
          smooth: false
        }
      }
    },
    lineData: [sharedDataset]
  },

  onInit() {
    engineInstance = createGameEngine(Date.now() & 0xffffffff)
    this.syncView(engineInstance.getRenderSnapshot(), true)
    this.loadSavedData()
  },

  onShow() {
    try {
      if (brightness && typeof brightness.setKeepScreenOn === 'function') {
        brightness.setKeepScreenOn({ keepScreenOn: true })
      }
    } catch (e) {}
    if (
      engineInstance &&
      engineInstance.state.status === 'playing' &&
      !this.showCrash &&
      !this.showSettings
    ) {
      this.startLoop()
    }
  },

  onHide() {
    this.isHolding = false
    this.stopLoop()
  },

  onDestroy() {
    this.stopLoop()
    try {
      if (brightness && typeof brightness.setKeepScreenOn === 'function') {
        brightness.setKeepScreenOn({ keepScreenOn: false })
      }
    } catch (e) {}
  },

  loadSavedData() {
    try {
      storage.get({
        key: 'rider_band10_v6',
        success: (data) => {
          if (data) {
            try {
              const parsed = JSON.parse(data)
              if (typeof parsed.best === 'number') {
                this.bestScore = parsed.best
                engineInstance.state.bestScore = parsed.best
              }
              if (typeof parsed.gems === 'number') {
                this.gems = parsed.gems
                engineInstance.state.gems = parsed.gems
              }
              if (typeof parsed.vibro === 'boolean') {
                this.vibroEnabled = parsed.vibro
                this.vibroLabel = parsed.vibro ? 'ВКЛ' : 'ВЫКЛ'
              }
              if (typeof parsed.fpsMode === 'number') {
                this.fpsTargetMode = parsed.fpsMode
                this.fpsModeLabel =
                  parsed.fpsMode === 0
                    ? '60 ГЦ'
                    : parsed.fpsMode === 1
                    ? '45 ГЦ'
                    : '30 ГЦ'
              }
              if (typeof parsed.fill === 'boolean') {
                this.fillEnabled = parsed.fill
                this.fillLabel = parsed.fill ? 'ГРАД' : 'ЛИНИЯ'
              }
              if (typeof parsed.turbo === 'boolean') {
                this.turboSpin = parsed.turbo
                this.spinLabel = parsed.turbo ? 'ТУРБО' : 'НОРМ'
                engineInstance.state.turboFlip = parsed.turbo
              }
              this.syncView(engineInstance.getRenderSnapshot(), true)
            } catch (e) {}
          }
        }
      })
    } catch (e) {}
  },

  saveProgress() {
    try {
      storage.set({
        key: 'rider_band10_v6',
        value: JSON.stringify({
          best: this.bestScore,
          gems: this.gems,
          vibro: this.vibroEnabled,
          fpsMode: this.fpsTargetMode,
          fill: this.fillEnabled,
          turbo: this.turboSpin
        })
      })
    } catch (e) {}
  },

  pulseHaptic(mode) {
    if (!this.vibroEnabled) return
    try {
      if (vibrator && typeof vibrator.vibrate === 'function') {
        vibrator.vibrate({ mode: mode || 'short' })
      }
    } catch (e) {}
  },

  getMinYieldMs() {
    if (this.fpsTargetMode === 0) return 10
    if (this.fpsTargetMode === 1) return 16
    return 24
  },

  startLoop() {
    this.stopLoop()
    const nowInit = Date.now()
    lastTickMs = nowInit
    fpsWindowStartMs = nowInit
    fpsFrameCount = 0

    const tick = () => {
      loopTimer = null
      if (!engineInstance || this.showSettings || this.showCrash) return
      if (engineInstance.state.status !== 'playing') return

      const now = Date.now()
      const dt = (now - lastTickMs) * 0.001
      lastTickMs = now

      fpsFrameCount += 1
      const elapsedFps = now - fpsWindowStartMs
      if (elapsedFps >= 800) {
        const currentFps = Math.min(60, Math.round((fpsFrameCount * 1000) / elapsedFps))
        const nextFpsText = currentFps + ' FPS'
        if (this.fpsText !== nextFpsText) {
          this.fpsText = nextFpsText
        }
        fpsFrameCount = 0
        fpsWindowStartMs = now
      }

      const res = engineInstance.step(dt, this.isHolding)
      this.syncView(engineInstance.getRenderSnapshot(), false)

      if (res.event === 'flip' || res.event === 'gem' || res.event === 'land') {
        this.pulseHaptic('short')
      } else if (res.event === 'crash') {
        this.isHolding = false
        this.showCrash = true
        this.crashTitle = engineInstance.state.crashReason || 'РАЗБИЛСЯ!'
        this.pulseHaptic('long')
        this.saveProgress()
        return
      }

      loopTimer = setTimeout(tick, this.getMinYieldMs())
    }
    loopTimer = setTimeout(tick, this.getMinYieldMs())
  },

  stopLoop() {
    if (loopTimer !== null) {
      clearTimeout(loopTimer)
      loopTimer = null
    }
  },

  syncView(snap, forceChart) {
    if (forceChart || snap.status === 'playing') {
      sharedDataset.strokeColor = snap.trackColor
      sharedDataset.fillColor = snap.fillColor
      sharedDataset.gradient = this.fillEnabled
      sharedDataset.data = snap.chartData
      this.lineData = [sharedDataset]
    }

    if (this.trackColor !== snap.trackColor) this.trackColor = snap.trackColor
    if (this.bikeColor !== snap.bikeColor) this.bikeColor = snap.bikeColor
    if (this.accentColor !== snap.accentColor) this.accentColor = snap.accentColor

    const b = snap.bike
    if (this.rx !== b.rx) this.rx = b.rx
    if (this.ry !== b.ry) this.ry = b.ry
    if (this.cx !== b.cx) this.cx = b.cx
    if (this.cy !== b.cy) this.cy = b.cy
    if (this.fx !== b.fx) this.fx = b.fx
    if (this.fy !== b.fy) this.fy = b.fy

    if (this.gemX !== snap.gemX) this.gemX = snap.gemX
    if (this.gemY !== snap.gemY) this.gemY = snap.gemY
    if (this.hazX !== snap.hazX) this.hazX = snap.hazX
    if (this.hazY !== snap.hazY) this.hazY = snap.hazY

    if (this.score !== snap.score) this.score = snap.score
    if (this.bestScore !== snap.bestScore) this.bestScore = snap.bestScore
    if (this.gems !== snap.gems) this.gems = snap.gems

    const nextInfo = snap.bannerText
      ? snap.bannerText
      : 'РЕКОРД ' + snap.bestScore + '  ◆ ' + snap.gems
    if (this.infoText !== nextInfo) {
      this.infoText = nextInfo
    }
  },

  onScreenHoldStart() {
    if (!engineInstance || this.showSettings || this.showCrash) return
    if (engineInstance.state.status !== 'playing') {
      engineInstance.startGame()
      this.syncView(engineInstance.getRenderSnapshot(), true)
      this.pulseHaptic('short')
      this.startLoop()
    }
    this.isHolding = true
  },

  onScreenHoldEnd() {
    this.isHolding = false
  },

  onRetryTap() {
    if (!engineInstance) return
    this.showCrash = false
    this.showSettings = false
    engineInstance.startGame()
    this.syncView(engineInstance.getRenderSnapshot(), true)
    this.pulseHaptic('short')
    this.startLoop()
  },

  onOpenSettings() {
    this.isHolding = false
    this.stopLoop()
    this.showSettings = true
    this.pulseHaptic('short')
  },

  onCloseSettings() {
    this.showSettings = false
    this.syncView(engineInstance.getRenderSnapshot(), true)
    this.pulseHaptic('short')
    if (engineInstance && engineInstance.state.status === 'playing' && !this.showCrash) {
      this.startLoop()
    }
  },

  onToggleVibro() {
    this.vibroEnabled = !this.vibroEnabled
    this.vibroLabel = this.vibroEnabled ? 'ВКЛ' : 'ВЫКЛ'
    if (this.vibroEnabled) this.pulseHaptic('short')
    this.saveProgress()
  },

  onCycleFpsMode() {
    this.fpsTargetMode = (this.fpsTargetMode + 1) % 3
    this.fpsModeLabel =
      this.fpsTargetMode === 0
        ? '60 ГЦ'
        : this.fpsTargetMode === 1
        ? '45 ГЦ'
        : '30 ГЦ'
    this.pulseHaptic('short')
    this.saveProgress()
  },

  onToggleFill() {
    this.fillEnabled = !this.fillEnabled
    this.fillLabel = this.fillEnabled ? 'ГРАД' : 'ЛИНИЯ'
    this.syncView(engineInstance.getRenderSnapshot(), true)
    this.pulseHaptic('short')
    this.saveProgress()
  },

  onToggleSpin() {
    this.turboSpin = !this.turboSpin
    this.spinLabel = this.turboSpin ? 'ТУРБО' : 'НОРМ'
    if (engineInstance) {
      engineInstance.state.turboFlip = this.turboSpin
    }
    this.pulseHaptic('short')
    this.saveProgress()
  },

  onResetBest() {
    this.bestScore = 0
    this.gems = 0
    if (engineInstance) {
      engineInstance.state.bestScore = 0
      engineInstance.state.gems = 0
    }
    this.pulseHaptic('long')
    this.saveProgress()
  }
}
</script>

<style>
.screen {
  width: 212px;
  height: 520px;
  background-color: #000000;
}

.game-layout {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  background-color: #000000;
}

.hud-top {
  width: 184px;
  height: 78px;
  margin-top: 12px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hud-row {
  width: 184px;
  height: 46px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.hud-spacer {
  width: 34px;
  height: 34px;
}

.hud-score {
  font-size: 38px;
  color: #FFFFFF;
}

.cfg-btn {
  width: 34px;
  height: 34px;
  border-radius: 17px;
  border-width: 2px;
  border-color: #00F0FF;
  background-color: #08131C;
  font-size: 18px;
  color: #00F0FF;
  text-align: center;
}

.hud-info {
  font-size: 15px;
  color: #FFD700;
  margin-top: 2px;
}

.viewport {
  width: 200px;
  height: 300px;
  background-color: #000000;
}

.track-chart {
  width: 200px;
  height: 300px;
}

.sprite-layer {
  width: 200px;
  height: 300px;
}

.bottom-bar {
  width: 212px;
  height: 96px;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  padding-bottom: 10px;
}

.fps-counter {
  width: 100px;
  height: 20px;
  font-size: 13px;
  color: #527084;
  text-align: center;
}

.bike-wheel {
  position: absolute;
  width: 12px;
  height: 12px;
  border-radius: 6px;
  border-width: 3px;
  border-color: #00F0FF;
  background-color: #000000;
}

.bike-core {
  position: absolute;
  width: 12px;
  height: 10px;
  border-radius: 5px;
  border-width: 2px;
  border-color: #FFD700;
  background-color: #FF006E;
}

.gem-node {
  position: absolute;
  width: 10px;
  height: 10px;
  border-radius: 5px;
  background-color: #FFD700;
}

.haz-node {
  position: absolute;
  width: 12px;
  height: 12px;
  border-radius: 6px;
  background-color: #FF1744;
}

.overlay-screen {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 212px;
  height: 520px;
  background-color: #060810;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.crash-title {
  font-size: 26px;
  color: #FF006E;
  margin-bottom: 14px;
}

.crash-stat {
  font-size: 24px;
  color: #FFFFFF;
  margin-bottom: 6px;
}

.crash-best {
  font-size: 15px;
  color: #FFD700;
  margin-bottom: 28px;
}

.retry-btn {
  width: 168px;
  height: 54px;
  border-radius: 27px;
  border-width: 3px;
  border-color: #00F0FF;
  background-color: #071F2C;
  font-size: 19px;
  color: #00F0FF;
  text-align: center;
  margin-top: 8px;
}

.sub-btn {
  width: 152px;
  height: 44px;
  border-radius: 22px;
  border-width: 2px;
  border-color: #384E63;
  background-color: #0C1620;
  font-size: 16px;
  color: #A0B8CC;
  text-align: center;
  margin-top: 14px;
}

.cfg-title {
  font-size: 22px;
  color: #00F0FF;
  margin-bottom: 12px;
}

.cfg-item {
  width: 176px;
  height: 42px;
  border-radius: 21px;
  border-width: 2px;
  border-color: #1F3647;
  background-color: #0A141E;
  font-size: 15px;
  color: #FFFFFF;
  text-align: center;
  margin-top: 6px;
}

.cfg-item-warn {
  width: 176px;
  height: 40px;
  border-radius: 20px;
  border-width: 2px;
  border-color: #55162B;
  background-color: #1A0810;
  font-size: 14px;
  color: #FF4477;
  text-align: center;
  margin-top: 8px;
  margin-bottom: 6px;
}
</style>
