console.log('[TEST 9/11] Checking zoom invariance...')
const zoom100 = createGameEngine(7777)
const zoom75 = createGameEngine(7777)
const zoom120 = createGameEngine(7777)
zoom100.state.zoomScale = 1.0
zoom75.state.zoomScale = 0.75
zoom120.state.zoomScale = 1.2
zoom100.startGame()
zoom75.startGame()
zoom120.startGame()
for (let i = 0; i < 800; i++) {
  if (zoom100.state.status !== 'playing') {
    zoom100.startGame()
    zoom75.startGame()
    zoom120.startGame()
  }
  const b = zoom100.state.bike
  const hold = (b.onGround && !b.sawAhead) || (!b.onGround && (b.airFlips < 1 || b.angle > 0.3))
  zoom100.step(0.016, hold)
  zoom75.step(0.016, hold)
  zoom120.step(0.016, hold)
  check(
    zoom100.state.bike.x === zoom75.state.bike.x &&
      zoom100.state.bike.x === zoom120.state.bike.x &&
      zoom100.state.bike.y === zoom75.state.bike.y &&
      zoom100.state.bike.y === zoom120.state.bike.y &&
      zoom100.state.bike.speed === zoom75.state.bike.speed &&
      zoom100.state.bike.speed === zoom120.state.bike.speed &&
      zoom100.state.status === zoom75.state.status &&
      zoom100.state.status === zoom120.state.status,
    'ZOOM_PHYSICS_INVARIANCE_STEP_' + i,
    { step: i }
  )
}
console.log('[PASS] Zoom invariance OK')

console.log('[TEST 10/11] Running proBot skill, flips, perfect landings & missions...')
const proBot = createGameEngine(2026)
proBot.startGame()
let flipsDone = 0
let landingsDone = 0
let perfectsDone = 0
for (let i = 0; i < 3200; i++) {
  if (proBot.state.status !== 'playing') {
    proBot.startGame()
  }
  const b = proBot.state.bike
  const hold = (b.onGround && !b.sawAhead) || (!b.onGround && (b.airFlips < 1 || b.angle > 0.25))
  const res = proBot.step(0.016, hold)
  if (res.event === 'flip') flipsDone += 1
  if (res.event === 'land' || res.event === 'perfect') landingsDone += 1
  if (res.event === 'perfect') perfectsDone += 1

  const snap = proBot.getRenderSnapshot()
  for (let j = 0; j < snap.chartData.length; j++) {
    const val = snap.chartData[j]
    check(val === 0 || (val >= 12 && val <= VIEW_H - 6), 'PROBOT_CHART_BOUNDS', {
      step: i,
      j,
      val
    })
  }
}
check(flipsDone >= 10 && landingsDone >= 8, 'PROBOT_FLIPS_AND_LANDINGS', {
  flipsDone,
  landingsDone,
  perfectsDone
})
console.log('[PASS] proBot skill OK:', { flipsDone, landingsDone, perfectsDone })

console.log('[TEST 11/11] Running 15,000-step endurance & memory stability test...')
for (let i = 0; i < 15000; i++) {
  if (proBot.state.status !== 'playing') proBot.startGame()
  const b = proBot.state.bike
  const hold = (b.onGround && !b.sawAhead) || (!b.onGround && (b.airFlips < 1 || b.angle > 0.25))
  proBot.step(0.016, hold)
  check(proBot.state.segs.length <= 48, 'ENDURANCE_SEGS_BOUNDED', {
    step: i,
    segsLen: proBot.state.segs.length
  })
  check(proBot.state.worldGems.length <= 36, 'ENDURANCE_GEMS_BOUNDED', {
    step: i,
    gemsLen: proBot.state.worldGems.length
  })
  check(proBot.state.hazards.length <= 24, 'ENDURANCE_HAZARDS_BOUNDED', {
    step: i,
    hazardsLen: proBot.state.hazards.length
  })
  check(proBot.state.pits.length <= 24, 'ENDURANCE_PITS_BOUNDED', {
    step: i,
    pitsLen: proBot.state.pits.length
  })
  check(proBot.state.bike.x <= 42000, 'ENDURANCE_WORLD_X_REBASED', {
    step: i,
    bikeX: proBot.state.bike.x
  })
}
console.log('[PASS] 15,000-step endurance OK')
console.log('ALL_11_RIDER_BAND10_SUITES_PASSED_OK', {
  flipsDone,
  landingsDone,
  perfectsDone,
  bestScore: proBot.state.bestScore
})
